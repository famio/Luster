{
  "name": "@famio/luster",
  "version": "0.3.0",
  "description": "Turns an SVG into a 3D enamel badge, struck in a worker by the Luster engine compiled to WebAssembly.",
  "license": "MIT",
  "author": "famio",
  "homepage": "https://github.com/famio/Luster/tree/main/web/luster#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/famio/Luster.git",
    "directory": "web/luster"
  },
  "bugs": {
    "url": "https://github.com/famio/Luster/issues"
  },
  "keywords": [
    "svg",
    "3d",
    "badge",
    "enamel",
    "pin",
    "webassembly",
    "wasm",
    "three",
    "web-component",
    "gltf"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./view": {
      "types": "./src/view.d.ts",
      "default": "./src/view.js"
    },
    "./snapshot": {
      "types": "./src/snapshot.d.ts",
      "default": "./src/snapshot.js"
    }
  },
  "files": [
    "src",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "engine/luster_wasm.js",
    "engine/luster_wasm_bg.wasm"
  ],
  "sideEffects": [
    "./src/view.js"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "prepack": "node scripts/prepack.mjs"
  },
  "peerDependencies": {
    "three": "^0.186.0"
  },
  "peerDependenciesMeta": {
    "three": {
      "optional": true
    }
  },
  "devDependencies": {
    "three": "0.186.1"
  }
}
