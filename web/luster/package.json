{
  "name": "@famio/luster",
  "version": "0.3.0",
  "private": true,
  "description": "Turns an SVG into a 3D enamel badge, struck in a worker by the Luster engine compiled to WebAssembly.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./view": {
      "types": "./src/view.d.ts",
      "default": "./src/view.js"
    }
  },
  "files": [
    "src",
    "README.md",
    "engine/luster_wasm.js",
    "engine/luster_wasm_bg.wasm"
  ],
  "sideEffects": [
    "./src/view.js"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node --test test/*.test.js"
  },
  "peerDependencies": {
    "three": "^0.186.0"
  },
  "peerDependenciesMeta": {
    "three": {
      "optional": true
    }
  },
  "devDependencies": {
    "three": "0.186.1"
  }
}
